{
  "manifest_version": 3,
  "name": "Snap Studio",
  "version": "0.1.0",
  "description": "Snap a screen, annotate it with the house component kit, export or copy it — built for the support team's ticket workflow.",
  "permissions": ["activeTab", "tabs", "storage", "scripting", "clipboardWrite"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_title": "Snap Studio",
    "default_popup": "src/popup.html"
  },
  "background": { "service_worker": "src/background.js" },
  "commands": {
    "capture": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Snap the visible tab"
    },
    "capture-region": {
      "suggested_key": { "default": "Alt+Shift+R" },
      "description": "Snap a region of the current tab"
    }
  }
}
